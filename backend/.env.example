# Copia este archivo a ".env" y ajusta los valores. NUNCA subas el ".env" real
# (ya está en .gitignore).

# "production" activa: redirección forzada a HTTPS, HSTS, y CORS estricto
# (el servidor no arranca en producción si ALLOWED_ORIGINS queda vacío).
# Usa "development" para trabajar en tu máquina/red local (Hamachi, etc).
NODE_ENV=development

PORT=3000

# Genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-hex-characters

# Dominio(s) exactos desde donde se sirve el frontend, separados por coma.
# Ejemplo en producción: ALLOWED_ORIGINS=https://tudominio.com
ALLOWED_ORIGINS=http://localhost:3000

# Opcional: llave de cifrado de orangematch.db (SQLCipher). Si no la pones
# aquí, el servidor genera y usa backend/.db_key automáticamente la primera
# vez. Solo defínela aquí si prefieres administrarla como variable de
# entorno (gestor de secretos, systemd, etc) en vez de un archivo en disco.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DB_ENCRYPTION_KEY=
